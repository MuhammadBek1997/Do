{
  "expo": {
    "name": "Zoomer Driver",
    "slug": "zoomer-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.zoomer.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Zoomer Driver buyurtmalarni qabul qilish uchun joylashuvingizga muhtoj.",
        "NSLocationAlwaysUsageDescription": "Zoomer Driver online bo'lganingizda joylashuvingizni doimiy kuzatib boradi."
      }
    },
    "android": {
      "package": "uz.zoomer.driver",
      "adaptiveIcon": {
        "backgroundColor": "#1F2937",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "VIBRATE"
      ]
    },
    "plugins": [
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "Zoomer Driver online bo'lganingizda joylashuvingizni doimiy kuzatib boradi.",
        "isAndroidBackgroundLocationEnabled": true
      }],
      "expo-notifications"
    ],
    "extra": {
      "yandexApiKey": "78def305-d849-4788-8262-e05dfc98d466",
      "apiUrl": "http://localhost:8080/api"
    }
  }
}
